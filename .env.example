# ─── Banco de dados ───────────────────────────────────────────────────
# Desenvolvimento sem Docker: `npm run db:local` sobe um PostgreSQL embutido na porta 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/abyss_arena"

# docker-compose.yml (a URL do app é montada a partir destas variáveis):
POSTGRES_USER=abyss
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=abyss_arena

# ─── Aplicação ────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"   # URL pública (usada em links de e-mail)
PORT=3000
# true quando servido por HTTPS (produção atrás do Caddy/Nginx)
SESSION_COOKIE_SECURE=false

# docker-compose: porta publicada no host e interface (127.0.0.1 = só via proxy local)
APP_PORT=3000
APP_BIND=127.0.0.1
# Domínio para HTTPS automático com o perfil "proxy" (Caddy)
DOMAIN=arena.exemplo.com

# ─── Conta administrativa (criada/garantida pelo seed) ────────────────
# Nunca há senha fixa no código: defina aqui. ADMIN_RESET_PASSWORD=true redefine a senha de um admin existente.
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_NICKNAME="Admin"
ADMIN_RESET_PASSWORD=false

# ─── Seed ─────────────────────────────────────────────────────────────
# Dados de demonstração (jogadores @demo.local, decks e partidas). Use apenas em desenvolvimento.
SEED_DEMO_DATA=false
# Senha dos jogadores de demonstração (se vazia, é gerada e exibida no console)
DEMO_PASSWORD=
# true = usa o snapshot local do catálogo (sem acesso à internet)
SEED_OFFLINE=false

# ─── Jobs e catálogo ──────────────────────────────────────────────────
# Métricas diárias, propostas semanais, publicação agendada e sincronização do catálogo
JOBS_ENABLED=true
CATALOG_SYNC_ENABLED=true
# Ordem de preferência das fontes de personagens
CATALOG_PROVIDERS=yatta,jmp
# Ciclos do Abismo (andar 12) sincronizados da wiki do Fandom; entram em vigor na virada
ABYSS_SYNC_ENABLED=true
# Fuso do servidor do jogo para a virada (04:00 local): -5 = América (Brasil), 1 = Europa, 8 = Ásia
ABYSS_SERVER_UTC_OFFSET=-5

# ─── E-mail (opcional — habilita a recuperação de senha) ──────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── PostgreSQL embutido (somente desenvolvimento/testes sem Docker) ──
LOCAL_DB_PORT=5433
# Testes: use um servidor existente em vez do PostgreSQL embutido
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
